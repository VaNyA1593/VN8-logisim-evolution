; Variables
ldi r2 0 ; X 
ldi r3 0 ; Y
ldi r4 0 ; Color

jmp pollLoop

fillColor:
ldi r1 0xf9 ; get draw size limit
lod r0 r1 r1 
; reset screen
ldi r5 0xf8
ldi r6 128
str r0 r5 r6
ldi r5 0xfa
str r0 r5 r0
; reset parameters
ldi r2 0
ldi r3 0
ldi r4 0

fillLoop:
; render pixel
ldi r5 0xf8
str r0 r5 r2 
adi r5 1
str r0 r5 r3 
adi r5 1
str r0 r5 r4

; do the increments

adi r2 1 ; X
adi r4 1 ; Color

; Check if row done

cmp r2 r1 
brh fillLoop nz

; reset X and increment Y

ldi r2 0
adi r3 1

; check if screen done

cmp r3 r1
brh fillLoop nz

pollLoop:
ldi r5 0xf8
ldi r6 4
pollLoopL:
lod r0 r5 r7
cmp r6 r7
brh pollLoopL nz
jmp fillColor



